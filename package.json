{
  "name": "thinkiac-desktop",
  "version": "1.0.0",
  "description": "ThinkIac Cloud e runtime local no mesmo aplicativo",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "check": "node --check electron/main.mjs && node --check electron/runtime-manager.mjs && node --check electron/cloud.mjs && node --check electron/window-preload.cjs",
    "build:win": "electron-builder --win portable"
  },
  "dependencies": {
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.thinkiac.desktop",
    "productName": "ThinkIac",
    "asar": true,
    "protocols": [{ "name": "ThinkIac", "schemes": ["thinkiac"] }],
    "extraResources": [{ "from": "runtime-bundle", "to": "runtime-bundle" }],
    "files": ["electron/**/*", "package.json"],
    "win": {
      "icon": "build/icon.ico",
      "target": [{ "target": "portable", "arch": ["x64"] }]
    },
    "portable": { "artifactName": "ThinkIac-${version}-win-x64.exe" }
  }
}

